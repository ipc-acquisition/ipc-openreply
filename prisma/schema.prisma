// ManyChat Alternative — B2B Instagram Comment → DM SaaS schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  ownedWorkspaces   Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers  WorkspaceMember[]
  sentInvitations   WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usagePeriodStart  DateTime @default(now())
  dmsSentThisPeriod Int      @default(0)

  zernioConnection  ZernioConnection?
  facebookPageConnection FacebookPageConnection?
  moderationRules   ModerationRule[]
  moderationLogs    ModerationLog[]
  contacts          Contact[]
  flows             Flow[]
  flowEnrollments   FlowEnrollment[]
  flowClicks        FlowClick[]
  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  instagramAccounts InstagramAccount[]
  automations       Automation[]
  dmLogs            DmLog[]
  trackedLinks      TrackedLink[]
  linkClicks        LinkClick[]
  webhookEvents     WebhookEvent[]
  operationalEvents OperationalEvent[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
}

model InstagramAccount {
  id                String   @id @default(cuid())
  workspaceId       String
  instagramId       String   @unique
  username          String
  name              String?
  provider          InstagramProvider @default(META)
  zernioAccountId   String?
  accessToken       String
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean  @default(false)
  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations Automation[]
  dmLogs      DmLog[]
  linkClicks  LinkClick[]
  followerSnapshots FollowerSnapshot[]
  moderationRules   ModerationRule[]
  moderationLogs    ModerationLog[]
  contacts          Contact[]
  flows             Flow[]

  @@index([workspaceId])
}

/// Daily follower total for one account. Instagram only retains ~30 days of
/// account insights, so history beyond that window exists only because we
/// record it here. One row per account per day.
model FollowerSnapshot {
  id                 String   @id @default(cuid())
  instagramAccountId String
  /// Midnight UTC of the day this count belongs to.
  date               DateTime @db.Date
  followersCount     Int
  /// True when the row was reconstructed from follower_count insight deltas
  /// rather than observed directly, so it can be corrected later.
  backfilled         Boolean  @default(false)
  createdAt          DateTime @default(now())

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, date])
  @@index([instagramAccountId, date])
}

model Automation {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String

  name           String
  goal           String?
  postId         String?
  postUrl        String?
  pendingNextReel Boolean @default(false)
  matchAnyPost   Boolean @default(false)
  keywords       String[]
  matchAnyWord   Boolean @default(false)
  // Also fire this campaign when someone sends a DM whose text matches the
  // keywords above. Independent of the post trigger — a DM has no media, so
  // postId / matchAnyPost do not apply to it.
  dmTriggerEnabled Boolean @default(false)
  dmMessage      String
  openingDmEnabled     Boolean @default(false)
  openingDmMessage     String?
  openingDmButtonLabel String?
  linkButtonLabel      String?
  requireFollow           Boolean @default(false)
  followPromptMessage     String?
  followPromptButtonLabel String?
  followUpEnabled Boolean @default(false)
  followUpMessage String?
  // Minutes to wait after the link is delivered before sending the follow-up.
  // 0 sends it right away.
  followUpDelayMinutes Int @default(0)
  publicReplyEnabled Boolean @default(false)
  publicReplyMessage String?
  publicReplyMessages String[] @default([])
  isActive       Boolean @default(true)
  wholeWordMatch Boolean @default(true)
  reportShareSlug    String? @unique
  reportShareEnabled Boolean @default(true)
  // Flow to start once the person replies to this campaign's private reply.
  flowId             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  flow             Flow?            @relation(fields: [flowId], references: [id], onDelete: SetNull)
  dmLogs           DmLog[]
  trackedLinks     TrackedLink[]
  linkClicks       LinkClick[]
  flowEnrollments  FlowEnrollment[]

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([postId])
}

model DmLog {
  id                 String     @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String

  commenterId   String
  commenterName String?
  // Page-scoped ID (PSID) returned by the private reply. On Facebook Pages the
  // comment author's id (when present) is not the Messenger id, so inbound
  // messages, postbacks and reads are matched to this field, not commenterId.
  recipientId   String?
  commentText   String
  commentId     String
  matchedKeyword String?
  status        DmStatus @default(PENDING)
  attempts      Int      @default(0)
  dmSentAt      DateTime?
  errorMessage  String?

  // The public comment reply is delivered independently of the DM, so its
  // outcome is tracked separately. publicReplySentAt makes it idempotent across
  // retries; a DM failure never blocks or re-posts the public reply.
  dmDeliveryUnconfirmed Boolean @default(false)
  publicReplyDeliveryUnconfirmed Boolean @default(false)
  publicReplySentAt DateTime?
  publicReplyError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([automationId, commentId])
  @@index([workspaceId])
  @@index([automationId])
  @@index([automationId, recipientId])
  @@index([instagramAccountId])
  @@index([status])
}

// Legacy reconciliation model; currently unwired. Runtime code does not read
// or write ProcessedComment. Current reconciliation dedup uses owner-reply
// checks and DmLog guards instead.
model ProcessedComment {
  id                 String   @id @default(cuid())
  instagramAccountId String
  commentId          String   @unique
  source             String // "WEBHOOK" | "POLLING"
  seenAt             DateTime @default(now())

  @@index([instagramAccountId])
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String
  slug           String   @unique
  label          String?
  destinationUrl String
  // Which DM button this link is, starting at 0. Read links with
  // TRACKED_LINK_ORDER (lib/tracking/link-order.ts), never by createdAt alone:
  // links saved in one request share a createdAt, and Postgres returns tied
  // rows in no fixed order.
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@index([workspaceId])
  @@index([automationId])
}

model LinkClick {
  id                 String   @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String
  trackedLinkId      String
  ipHash             String?
  // Token from the link's `?r=` (hashRecipientId), set on links sent in a DM.
  // Clicks are counted once per recipient, falling back to ipHash without it.
  recipientHash      String?
  userAgent          String?
  referrer           String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  trackedLink      TrackedLink      @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([trackedLinkId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

model WebhookEvent {
  id          String        @id @default(cuid())
  workspaceId String?
  object      String?
  payload     Json
  // Which connection the payload came through. Needed to replay it: Zernio
  // payloads reuse the "instagram" object. Null on rows written before.
  provider    InstagramProvider?
  status      WebhookStatus @default(PENDING)
  errorMessage String?
  createdAt   DateTime      @default(now())
  processedAt DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
}

model OperationalEvent {
  id          String                @id @default(cuid())
  workspaceId String?
  source      OperationalEventSource
  level       OperationalEventLevel @default(INFO)
  message     String
  payload     Json?
  createdAt   DateTime              @default(now())
  resolvedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DmStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DEDUP
  SKIPPED_RATE_LIMIT
  SKIPPED_PLAN_LIMIT
  SKIPPED_NO_MATCH
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
  // Persisted but not handed to Redis (outage or timeout). The worker replays
  // these; see replayUnqueuedWebhookEvents.
  NOT_ENQUEUED
}

enum OperationalEventSource {
  WORKER
  TOKEN_REFRESH
  HEALTH
  SYSTEM
}

enum OperationalEventLevel {
  INFO
  WARNING
  ERROR
}


enum InstagramProvider {
  META
  ZERNIO
  FACEBOOK_PAGE
}

model ZernioConnection {
  workspaceId    String @id
  apiKey         String
  profileId      String?
  webhookId      String?
  webhookSecret  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Facebook Pages are connected through a Business Manager system user: the
// owner pastes its token once, and each assigned Page becomes an
// InstagramAccount with provider FACEBOOK_PAGE (instagramId = Page id,
// accessToken = encrypted Page token). The system user token is kept here,
// encrypted, so Page tokens can be regenerated via /me/accounts.
/// The token Pages are read from, one per workspace. Despite the column names
/// (kept for the additive-schema rule), it is either a system user token or a
/// long-lived token of the person who clicked "Connect with Facebook"
/// (`tokenKind`). Under Standard Access only the second can message people
/// without a role on the app, because a system user never has an app role.
model FacebookPageConnection {
  workspaceId         String   @id
  systemUserToken     String
  systemUserId        String
  tokenKind           FacebookTokenKind @default(SYSTEM_USER)
  /// Display name of the system user or person behind the token.
  ownerName           String?
  /// When the long-lived user token itself expires (about 60 days). Page tokens
  /// derived from it keep working past this date.
  tokenExpiresAt      DateTime?
  /// When Meta stops honouring the person's data access grant (about 90 days
  /// without a new login). Page calls fail after it until they reconnect.
  dataAccessExpiresAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum FacebookTokenKind {
  SYSTEM_USER
  USER
}

// --- Comment moderation -----------------------------------------------------
// A rule is a word list for one Page: a comment containing any of the words is
// hidden before any campaign runs for it. Rules are the first, cheapest stage
// of the moderation pipeline; heuristics and AI classification plug into the
// same log later.
model ModerationRule {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  name               String
  keywords           String[] @default([])
  // Off by default: moderation errs on the side of hiding, so "fake" also
  // catches "fakee" and "fakes".
  wholeWordMatch     Boolean  @default(false)
  action             ModerationAction @default(HIDE)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  logs             ModerationLog[]

  @@index([workspaceId])
  @@index([instagramAccountId])
}

// One row per moderated comment. Created BEFORE the Meta call as the delivery
// claim (commentId is unique), then updated with the outcome.
model ModerationLog {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  ruleId             String?
  commentId          String   @unique
  mediaId            String?
  commenterId        String
  commenterName      String?
  commentText        String
  matchedKeyword     String?
  action             ModerationAction
  actionStatus       ModerationActionStatus @default(PENDING)
  error              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  rule             ModerationRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([instagramAccountId, createdAt])
  @@index([workspaceId])
}

enum ModerationAction {
  HIDE
  DELETE
}

enum ModerationActionStatus {
  PENDING
  DONE
  FAILED
  UNDONE
}

// --- Messenger flows (drip sequences) ---------------------------------------
// A Flow is a sequence of DMs sent to a person after they message the Page,
// inside the 24-hour Messenger window that each of their messages reopens.
// Every step is tracked on its own (sent, read, clicked) so the panel can show
// per-message numbers the way ManyChat does.

// One row per person per Page, keyed by their PSID. lastInboundAt is what the
// 24-hour window is computed from.
model Contact {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  psid               String
  name               String?
  firstSeenAt        DateTime @default(now())
  lastInboundAt      DateTime?
  optedOutAt         DateTime?
  // Set when a human answers this person (panel inbox or Meta's own inbox);
  // flows stay quiet until it passes. Not wired yet.
  humanTakeoverUntil DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  enrollments      FlowEnrollment[]

  @@unique([instagramAccountId, psid])
  @@index([workspaceId])
}

model Flow {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  name               String
  isActive           Boolean  @default(true)
  // Any inbound DM enrolls by default; keywords narrow it down when set.
  triggerAnyMessage  Boolean  @default(true)
  triggerKeywords    String[] @default([])
  wholeWordMatch     Boolean  @default(false)
  stopKeywords       String[] @default(["parar", "sair", "stop", "cancelar"])
  // When a step was skipped because the window closed, the person's next
  // message reopens it and the pending step goes out.
  resumeOnReply      Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  steps            FlowStep[]
  enrollments      FlowEnrollment[]
  automations      Automation[]

  @@index([workspaceId])
  @@index([instagramAccountId])
}

model FlowStep {
  id           String   @id @default(cuid())
  flowId       String
  position     Int
  // Minutes after the previous step was sent (after enrollment for step 0).
  delayMinutes Int      @default(0)
  // Supports {username}.
  message      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  flow     Flow          @relation(fields: [flowId], references: [id], onDelete: Cascade)
  buttons  FlowButton[]
  sendLogs FlowSendLog[]

  @@unique([flowId, position])
}

// A CTA button on a step: its own title, its own tracked URL. Resolved by the
// same /r/{slug} redirect as campaign links.
model FlowButton {
  id        String   @id @default(cuid())
  stepId    String
  position  Int
  title     String
  url       String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  step   FlowStep    @relation(fields: [stepId], references: [id], onDelete: Cascade)
  clicks FlowClick[]

  @@unique([stepId, position])
}

// One person's progress through one flow. A person enters a flow once.
model FlowEnrollment {
  id               String               @id @default(cuid())
  workspaceId      String
  flowId           String
  contactId        String
  // The comment-to-DM campaign whose reply brought the person here, if any.
  automationId     String?
  status           FlowEnrollmentStatus @default(ACTIVE)
  nextStepPosition Int                  @default(0)
  nextRunAt        DateTime?
  enrolledAt       DateTime             @default(now())
  endedAt          DateTime?
  updatedAt        DateTime             @updatedAt

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  flow       Flow          @relation(fields: [flowId], references: [id], onDelete: Cascade)
  contact    Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  automation Automation?   @relation(fields: [automationId], references: [id], onDelete: SetNull)
  sendLogs   FlowSendLog[]
  clicks     FlowClick[]

  @@unique([flowId, contactId])
  @@index([workspaceId])
  @@index([contactId])
  @@index([status])
}

// One row per step per enrollment. Created as the claim BEFORE the Meta call
// (CLAIMED), then SENT/FAILED/SKIPPED_*; readAt comes from message_reads.
model FlowSendLog {
  id           String         @id @default(cuid())
  enrollmentId String
  stepId       String
  status       FlowSendStatus
  mid          String?
  error        String?
  createdAt    DateTime       @default(now())
  sentAt       DateTime?
  readAt       DateTime?

  enrollment FlowEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  step       FlowStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, stepId])
  @@index([stepId, status])
}

model FlowClick {
  id            String   @id @default(cuid())
  workspaceId   String
  buttonId      String
  enrollmentId  String?
  // hashRecipientId token from `?r=`; clicks count once per person.
  recipientHash String?
  ipHash        String?
  userAgent     String?
  createdAt     DateTime @default(now())

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  button     FlowButton      @relation(fields: [buttonId], references: [id], onDelete: Cascade)
  enrollment FlowEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@index([buttonId])
  @@index([workspaceId, createdAt])
}

enum FlowEnrollmentStatus {
  ACTIVE
  PAUSED_WINDOW
  PAUSED_TAKEOVER
  COMPLETED
  STOPPED_OPTOUT
  STOPPED_MANUAL
}

enum FlowSendStatus {
  CLAIMED
  SENT
  FAILED
  SKIPPED_WINDOW
  SKIPPED_TAKEOVER
  SKIPPED_OPTOUT
}

// Claims persist independently of BullMQ retention so old taps never resend.
model PostbackDelivery {
  id String @id
  createdAt DateTime @default(now())
}
